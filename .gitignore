# Demo video tooling: keep the script, ignore its environment, scratch files and the big output
/demo_video/.venv/
/demo_video/tmp/
/demo_video/work/
/demo_video/*.mp4
/demo_video/*.exe
/demo_video/run.log
# Frontend: ship the built app (frontend/dist) so `python server.py` works without Node
node_modules/
__pycache__/
*.pyc

# --- Secrets and environments: never commit these ---
.env
*.pem
*.key
.aws/
credentials*
.venv/
venv/
